{
  "stack": "nextjs",
  "packageManager": "pnpm",
  "architecture": "ddd",
  "paths": {
    "web": ".",
    "tests": "tests"
  },
  "commands": {
    "typecheck": "pnpm typecheck",
    "lint": "pnpm lint",
    "test": "pnpm test",
    "build": "pnpm build"
  },
  "git": {
    "baseBranch": "release",
    "releaseBranch": "main",
    "mergeStrategy": "squash",
    "protectedBranches": [
      "main",
      "release"
    ],
    "humanMergeTargets": [
      "main"
    ]
  }
}
