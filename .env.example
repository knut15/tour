# ─────────────────────────────────────────────────────────────
# 서울 여행 웹앱 환경변수 템플릿
# 이 파일을 복사해 .env.local 을 만들고 값을 채운다.
#   cp .env.example .env.local
#
# NEXT_PUBLIC_ 접두사가 붙은 값은 빌드 시점에 클라이언트 번들로
# 인라인된다. 비밀값에는 절대 붙이지 않는다.
# ─────────────────────────────────────────────────────────────

# ── 한국관광공사 TourAPI (data.go.kr) ────────────────────────
# 서버 전용.
# 국문은 KorService2, 영문은 EngService2 로 **별개 서비스**다. 둘 다 활용신청해야 한다.
#
# 반드시 **디코딩된** 일반 인증키를 넣는다 (%2F, %3D 가 없는 형태).
# 인코딩 키를 넣고 URLSearchParams 로 넘기면 이중 인코딩으로 HTTP 403 이 난다.
# 근거: .curvez/research/tourapi-endpoints-v2.md 사실 6 (실측)
TOUR_API_KEY=

# ── 기상청 단기예보 / 에어코리아 (data.go.kr) ────────────────
# 서버 전용. **둘 다 선택값이다 — 비워 두면 TOUR_API_KEY 를 쓴다.**
#
# data.go.kr 인증키는 계정당 하나라, 위의 TOUR_API_KEY 값 그대로 기상청
# 단기예보(VilageFcstInfoService_2.0)와 에어코리아 대기오염정보
# (ArpltnInforInqireSvc)가 정상 응답하는 것을 실제 호출로 확인했다(2026-08-19).
# 서비스별 활용신청은 각각 해야 하지만 키 값은 같다.
#
# 계정을 나누거나 키를 갈아 끼울 때만 채운다. 여기도 디코딩된 키를 넣는다.
KMA_SERVICE_KEY=
AIRKOREA_SERVICE_KEY=

# ── 카카오맵 (developers.kakao.com) ──────────────────────────
# JavaScript 키. 클라이언트에서 SDK 를 로드하므로 공개값이다.
# 앱 설정 > 플랫폼 > Web 에 http://localhost:3000 을 등록해야 동작한다.
NEXT_PUBLIC_KAKAO_MAP_KEY=

# ── Supabase (supabase.com) ──────────────────────────────────
# Project Settings > API Keys 에서 확인한다.
#
# 레거시 anon / service_role 키는 2026년 말 deprecated 된다.
# 새 키를 쓴다 — publishable 은 sb_publishable_... 형식이다.
# 근거: .curvez/research/supabase-auth-flow.md 사실 9~12
#
# **이 둘이면 좋아요·조회가 쓰기까지 동작한다.** 세는 일은 전부 security definer
# 함수(toggle_spot_like · record_spot_view)가 하고 그 함수는 RLS 를 우회하도록
# 만들어져 있어, 공개 키로 불러도 된다. 테이블 직접 쓰기는 어떤 역할에도 열려
# 있지 않다 (supabase/migrations/0001_spot_stats.sql).
#
# **서버 전용 secret 키가 이제 필요하다.** 인스타 발행 큐(`ig_queue`)는 정책을 하나도
# 두지 않아 공개 키로는 아무 줄도 보이지 않는다 — 아직 안 나간 글이 브라우저에 보일
# 이유가 없기 때문이다. cron 만 service role 로 읽고 쓴다.
# 비워 두면 초안·발행 cron 이 `queue-not-configured` 로 아무것도 하지 않는다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── Anthropic (console.anthropic.com) ────────────────────────
# 서버 전용. AI 일정 추천에 쓴다.
ANTHROPIC_API_KEY=

# ── 개발 플래그 ──────────────────────────────────────────────
# true 면 TourAPI 대신 mock 어댑터를 쓴다.
# TOUR_API_KEY 를 채우면 false 로 바꾼다.
USE_MOCK_DATA=true
